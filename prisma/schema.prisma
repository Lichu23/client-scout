generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  INTERESTED
  NOT_INTERESTED
  CLIENT
}

model Search {
  id             String   @id @default(cuid())
  businessType   String
  location       String
  description    String?
  requestedLeads Int
  createdAt      DateTime @default(now())
  leads          Lead[]
  appearances    SearchLead[]
}

model Lead {
  id                String     @id @default(cuid())
  searchId          String
  search            Search     @relation(fields: [searchId], references: [id], onDelete: Cascade)
  businessName      String
  businessType      String
  location          String
  phone             String?
  source            String     @default("Google Places")
  googlePlaceId     String?    @unique
  googleMapsUrl     String?
  websiteUrl        String?
  websiteDomain     String?
  instagramUrl      String?
  instagramUsername String?
  hasWebsite        Boolean    @default(false)
  hasInstagram      Boolean    @default(false)
  hasBooking        Boolean?
  hasAppointment     Boolean?
  hasEcommerce      Boolean?
  hasHttps          Boolean?
  hasContactForm    Boolean?
  hasWhatsApp       Boolean?
  websiteAnalyzedAt DateTime?
  enrichmentStatus  String?
  opportunity       String?
  opportunityReason String?
  leadScore         Int?
  scoreReasons      String?
  suggestedOffer    String?
  analysisConfidence String?
  analysisEvidence  String?
  status            LeadStatus @default(NEW)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  outreachMessages  OutreachMessage[]

  @@index([businessName, location])
  @@index([websiteDomain])
  appearances       SearchLead[]
}

model SearchLead {
  id        String   @id @default(cuid())
  searchId  String
  leadId    String
  createdAt DateTime @default(now())
  search    Search  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([searchId, leadId])
  @@index([searchId, createdAt])
}

model OutreachMessage {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}




